<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>1.1.1</Version>
        <OutputType>Library</OutputType>
        <AssemblyName>$(ProjectName)</AssemblyName>
        <RootNamespace>$(ProjectName)</RootNamespace>
        <AssemblyVersion>7.0.6</AssemblyVersion>
        <FileVersion>7.0.6</FileVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RunPostBuildEvent>Always</RunPostBuildEvent>
    </PropertyGroup>

	<Target Name="CopyToPlugins" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
		<!-- For development: copy output dll directly to EXILED path -->
		<Copy SourceFiles="$(OutputPath)$(ProjectName).dll" DestinationFolder="$(EXILED_PLUGINS)" SkipUnchangedFiles="false" />
	</Target>

	<Target Name="MergeWithCore" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<!-- This merges the CommonUtils.Core.dll with this dll so it doesn't need to be shipped as a dependency. -->
		<Exec Command="$(ILMergeConsolePath) ^
			  /lib:$(EXILED_REFERENCES) ^
			  /lib:$(EXILED_PLUGINS)\dependencies ^
			  /out:$(OutputPath)$(ProjectName).dll ^
			  $(OutputPath)$(ProjectName).dll ^
			  $(EXILED_PLUGINS)\dependencies\CommonUtils.Core.dll" />
	</Target>

    <PropertyGroup>
        <RepositoryUrl>https://github.com/reid-sutherland/RoundReports</RepositoryUrl>
    </PropertyGroup>

    <Import Project="../Plugin.props" />

	<ItemGroup>
		<PackageReference Include="ExMod.Exiled" Version="9.6.1" />
		<PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" />
		<PackageReference Include="StyleCop.Analyzers" Version="$(StyleCopVersion)" IncludeAssets="All" PrivateAssets="All" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

		<PackageReference Include="ILMerge" Version="3.0.40" />
    </ItemGroup>

	<ItemGroup>
		<Reference Include="CommonUtils.Core" HintPath="$(EXILED_PLUGINS)\dependencies\CommonUtils.Core.dll" Private="false" />
	</ItemGroup>

    <ItemGroup>
		<Reference Include="Assembly-CSharp" HintPath="$(EXILED_REFERENCES)\Assembly-CSharp-Publicized.dll" Private="false" />
        <Reference Include="Assembly-CSharp-firstpass" HintPath="$(EXILED_REFERENCES)\Assembly-CSharp-firstpass.dll" Private="false" />
		<Reference Include="CommandSystem.Core" HintPath="$(EXILED_REFERENCES)\CommandSystem.Core.dll" Private="false" />
		<Reference Include="LabApi" HintPath="$(EXILED_REFERENCES)\LabApi.dll" Private="false" />
        <Reference Include="Mirror" HintPath="$(EXILED_REFERENCES)\Mirror.dll" Private="false" />
        <Reference Include="UnityEngine" HintPath="$(EXILED_REFERENCES)\UnityEngine.dll" Private="false" />
        <Reference Include="UnityEngine.CoreModule" HintPath="$(EXILED_REFERENCES)\UnityEngine.CoreModule.dll" Private="false" />
        <Reference Include="UnityEngine.PhysicsModule" HintPath="$(EXILED_REFERENCES)\UnityEngine.PhysicsModule.dll" Private="false" />
        <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(EXILED_REFERENCES)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
        <Reference Include="YamlDotNet" HintPath="$(EXILED_REFERENCES)\YamlDotNet.dll" Private="false" />
    </ItemGroup>
</Project>
